<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2><%= project.title %></h2>
    <p><%= project.description %></p>
    <p>Date: <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
    <p>Location: <%= project.location %></p>
    <p>Organization: <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>

    <h3>Categories</h3>
    <% if (categories.length > 0) { %>
        <ul>
            <% categories.forEach(category => { %>
                <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No categories assigned to this project.</p>
    <% } %>

    <% if (isLoggedIn) { %>
        <% if (volunteering) { %>
            <p>You are volunteering for this project.</p>
            <form method="POST" action="/project/<%= project.project_id %>/unvolunteer">
                <button type="submit">Remove me as a volunteer</button>
            </form>
        <% } else { %>
            <form method="POST" action="/project/<%= project.project_id %>/volunteer">
                <button type="submit">Volunteer for this project</button>
            </form>
        <% } %>
    <% } %>

    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/project/<%= project.project_id %>/assign-categories">Assign Categories</a></p>
        <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
    <% } %>

</main>

<%- include('partials/footer') %>