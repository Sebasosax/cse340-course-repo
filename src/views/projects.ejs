<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <p>Here you will find our service projects.</p>

    <% projects.forEach(project => { %>
        <div>
            <h2><%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>: <%= project.title %> (<%= project.organization_name %>)</h2>
            <p><%= project.description %></p>
            <p>Location: <%= project.location %></p>
        </div>
    <% }) %>

</main>

<%- include('partials/footer') %>