<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <p>Here you will find our upcoming service projects.</p>

    <% projects.forEach(project => { %>
        <div>
            <h2>
                <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)
            </h2>
            <p><%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
            <p><%= project.description %></p>
            <p>Location: <%= project.location %></p>
        </div>
    <% }) %>

    <p><a href="/new-project">Add a new service project</a></p>

</main>

<%- include('partials/footer') %>