<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <p>Here you will find our partner organizations.</p>

    <% organizations.forEach(org => { %>
        <div>
            <h2><a href="/organization/<%= org.organization_id %>"><%= org.name %></a></h2>
            <img src="/images/<%= org.logo_filename %>" alt="<%= org.name %> logo">
            <p><%= org.description %></p>
            <p>Contact: <a href="mailto:<%= org.contact_email %>"><%= org.contact_email %></a></p>
        </div>
    <% }) %>

    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/new-organization">Add a new organization</a></p>
    <% } %>

</main>

<%- include('partials/footer') %>