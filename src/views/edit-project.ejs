<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <%- include('partials/messages') %>

    <form action="/edit-project/<%= projectDetails.project_id %>" method="POST">

        <div>
            <label for="title">Title</label>
            <input
                type="text"
                id="title"
                name="title"
                value="<%= projectDetails.title %>"
                required
            >
        </div>

        <div>
            <label for="description">Description</label>
            <textarea id="description" name="description" required><%= projectDetails.description %></textarea>
        </div>

        <div>
            <label for="location">Location</label>
            <input
                type="text"
                id="location"
                name="location"
                value="<%= projectDetails.location %>"
                required
            >
        </div>

        <div>
            <label for="date">Date</label>
            <input
                type="date"
                id="date"
                name="date"
                value="<%= new Date(projectDetails.date).toISOString().split('T')[0] %>"
                required
            >
        </div>

        <div>
            <label for="organizationId">Organization</label>
            <select id="organizationId" name="organizationId" required>
                <% organizations.forEach(org => { %>
                    <option
                        value="<%= org.organization_id %>"
                        <%= org.organization_id === projectDetails.organization_id ? 'selected' : '' %>
                    >
                        <%= org.name %>
                    </option>
                <% }) %>
            </select>
        </div>

        <button type="submit">Save Changes</button>
    </form>

    <a href="/project/<%= projectDetails.project_id %>">Cancel</a>
</main>

<%- include('partials/footer') %>