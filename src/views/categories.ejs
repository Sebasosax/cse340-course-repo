<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <p>Here you will find our service project categories.</p>

    <% categories.forEach(category => { %>
        <div>
            <h2><a href="/category/<%= category.category_id %>"><%= category.name %></a></h2>
        </div>
    <% }) %>

    <p><a href="/new-category">Add New Category</a></p>

</main>

<%- include('partials/footer') %>